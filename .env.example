# ==============================================================================
# EduSense Root Environment Configuration Template
# DO NOT store real secrets or credentials in this file.
# Copy this file to .env and replace placeholder values for local development.
# ==============================================================================

# Application
APP_NAME=EduSense API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database (pgvector enabled)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=edusense_db
POSTGRES_USER=edusense_user
POSTGRES_PASSWORD=edusense_dev_password
DATABASE_URL=postgresql+asyncpg://edusense_user:edusense_dev_password@postgres:5432/edusense_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis Cache, Quota & Celery Message Broker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# MinIO Object Storage (S3 API compatible)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=edusense-documents
MINIO_SECURE=false

# AI Service & Gemini API (Adapter configuration)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768

# Google OAuth2 Social Login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

